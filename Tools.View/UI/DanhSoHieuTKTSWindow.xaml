<Window
    x:Class="Tools.View.UI.DanhSoHieuTKTSWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tools.View.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    Title="{x:Static res:Lang.TS_UI_DanhSoHieuVaThongKeThepSanTuDong}"
    Loaded="BangToaDoCocWindow_Loaded"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="{x:Static res:Lang.TS_UI_XacLapChieuDaiBeMocThepVaChieuDayLopBe}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <RadioButton
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.TS_UI_CoDinhChoTatCaThanhThep}"
                    GroupName="DaiMocThep"
                    IsChecked="{Binding IsCoDinh}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center"
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                    Foreground="Red"
                    Text="{Binding HookLength}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="(mm)" />

                <RadioButton
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.TS_UI_ChieuDaiThucTrongBanVe}"
                    GroupName="DaiMocThep"
                    IsChecked="{Binding IsThucTe}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.TS_UI_ChieuDayLopBeTongBaoVe}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center"
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                    Foreground="Red"
                    Text="{Binding ChieuDayBTBaoVe}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="(mm)" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="{x:Static res:Lang.TS_UI_XacLapDanhSoHieuThepSanTuDong}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.Common_UI_QuyTacDanhSoHieu}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.Common_UI_TraiSangPhai}"
                    GroupName="HuongBoTri"
                    IsChecked="{Binding IsLeftToRight}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.Common_UI_TrenXuongDuoi}"
                    GroupName="HuongBoTri"
                    IsChecked="{Binding IsTopToBottom}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.TS_UI_SoHieuBatDauCoDinh}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="100"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                    Foreground="Red"
                    Text="{Binding SoHieuStart}" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Margin="0,0,0,10"
            Header="{x:Static res:Lang.TS_UI_XacLapTyLeBanVe}">
            <Grid Height="30" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.Common_UI_TyLeBanVe}" />
                <TextBox
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                    Foreground="Red"
                    Text="{Binding Scale}" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="100"
                Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding DanhSoCmd}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.Common_UI_DanhSoHieuTuDong}"
                    TextAlignment="Center" />
            </Button>

            <Button
                Grid.Column="1"
                Width="100"
                Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding DrawTableCmd}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.Common_UI_VeBangThongKeThep}"
                    TextAlignment="Center" />
            </Button>

            <Button
                Grid.Column="2"
                Width="100"
                Height="40"
                HorizontalContentAlignment="Center"
                Command="{Binding CancelCmd}"
                Content="{x:Static res:Lang.Common_UI_Thoat}" />
        </Grid>
    </Grid>
</Window>
