<Window x:Class="Tools.View.UI.WindowOpeningSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
        xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
        Title="{x:Static res:Lang.AW_UI_DoRongCuaSoKhoangCachMepTuong}"
        Width="500"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F3F3F3">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="{x:Static res:Lang.AW_UI_ChonDoRongCuaSo}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Lang.Common_UI_DanhSachDoRong}" />
                <ListBox x:Name="HoleWidthList" x:FieldModifier="public"
                         Grid.Row="1"
                         HorizontalContentAlignment="Right"
                         Margin="0,4"/>
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Lang.Common_UI_DoRong}" />
                    <TextBox x:Name="HoleWidthText" x:FieldModifier="public"
                             Grid.Column="1"
                             Height="25"
                             Margin="5,0,0,0"
                             Padding="3"
                             HorizontalContentAlignment="Right"
                             behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"/>
                </Grid>
                <Button x:Name="MeasureHoleButton" x:FieldModifier="public" Grid.Row="3"
                        Height="25"
                        Margin="0,5,0,0"
                        Content="{x:Static res:Lang.Common_UI_DoDoRong}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="{x:Static res:Lang.Common_UI_ChonKhoangCachMepTuong}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Lang.Common_UI_DanhSachKhoangCach}" />
                <ListBox x:Name="PierWidthList" x:FieldModifier="public"
                         Grid.Row="1"
                         HorizontalContentAlignment="Right"
                         Margin="0,4"/>
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Lang.AW_UI_KhoangCach}" />
                    <TextBox x:Name="PierWidthText" x:FieldModifier="public"
                             Grid.Column="1"
                             Height="25"
                             Margin="5,0,0,0"
                             Padding="3"
                             HorizontalContentAlignment="Right"
                             behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"/>
                </Grid>
                <Button x:Name="MeasurePierButton" x:FieldModifier="public"
                        Grid.Row="3"
                        Height="25"
                        Margin="0,5,0,0"
                        Content="{x:Static res:Lang.Common_UI_DoKhoangCach}" />
            </Grid>
        </GroupBox>

        <Button x:Name="ExistingWindowWidthButton" x:FieldModifier="public"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="25"
                Margin="2,8,2,0"
                Content="{x:Static res:Lang.AW_UI_LayDoRongTuCuaSoCoSan}" />

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="PocketWidthCheck" x:FieldModifier="public" GroupName="WindowPlacementMode"
                      VerticalAlignment="Center"
                      Content="{x:Static res:Lang.Common_UI_DoTuMepTuong}" />
            <RadioButton x:Name="MiddleWallCheck" x:FieldModifier="public" GroupName="WindowPlacementMode"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Content="{x:Static res:Lang.AW_UI_CuaSoGiuaTuong}" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button x:Name="AcceptButton" x:FieldModifier="public" Width="75" Height="28" Margin="0,0,12,0" IsDefault="True" Content="{x:Static res:Lang.Common_UI_DongY}" />
            <Button x:Name="CancelButton" x:FieldModifier="public" Width="75" Height="28" IsCancel="True" Content="{x:Static res:Lang.Common_UI_Huy}" />
        </StackPanel>
    </Grid>
</Window>
