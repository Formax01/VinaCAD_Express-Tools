<Window x:Class="Tools.View.UI.WindowOpeningSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
        Title="Độ rộng cửa sổ/Khoảng trụ"
        Width="400"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F3F3F3">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Chọn độ rộng cửa sổ">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Danh sách độ rộng" />
                <ListBox x:Name="HoleWidthList" x:FieldModifier="public"
                         Grid.Row="1"
                         Margin="0,4"
                         />
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Độ rộng:" />
                    <TextBox x:Name="HoleWidthText" x:FieldModifier="public"
                             Grid.Column="1"
                             Height="25"
                             Margin="5,0,0,0"
                             Padding="3"
                             HorizontalContentAlignment="Right"
                             behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"/>
                </Grid>
                <Button x:Name="MeasureHoleButton" x:FieldModifier="public" Grid.Row="3"
                        Height="25"
                        Margin="0,5,0,0"
                        Content="Đo" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Chọn khoảng trụ">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Danh sách khoảng trụ" />
                <ListBox x:Name="PierWidthList" x:FieldModifier="public"
                         Grid.Row="1"
                         Margin="0,4"
                         />
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Khoảng trụ:" />
                    <TextBox x:Name="PierWidthText" x:FieldModifier="public"
                             Grid.Column="1"
                             Height="25"
                             Margin="5,0,0,0"
                             Padding="3"
                             HorizontalContentAlignment="Right"
                             behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"/>
                </Grid>
                <Button x:Name="MeasurePierButton" x:FieldModifier="public"
                        Grid.Row="3"
                        Height="25"
                        Margin="0,5,0,0"
                        Content="Đo" />
            </Grid>
        </GroupBox>

        <Button x:Name="ExistingWindowWidthButton" x:FieldModifier="public"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="25"
                Margin="2,8,2,0"
                Content="Lấy độ rộng từ cửa sổ có sẵn" />

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="PocketWidthCheck" x:FieldModifier="public"
                      VerticalAlignment="Center"
                      Content="Đo từ mép tường" />
            <CheckBox x:Name="MiddleWallCheck" x:FieldModifier="public"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Content="Cửa sổ giữa tường" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button x:Name="AcceptButton" x:FieldModifier="public" Width="75" Height="28" Margin="0,0,12,0" IsDefault="True" Content="OK" />
            <Button x:Name="CancelButton" x:FieldModifier="public" Width="75" Height="28" IsCancel="True" Content="Hủy" />
        </StackPanel>
    </Grid>
</Window>
