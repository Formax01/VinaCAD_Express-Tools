<Window x:Class="Tools.VinaCAD.UI.WallThicknessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Độ Dày Tường" 
        Height="400" Width="300"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Danh Sách Độ Dày Tường" Margin="0,0,0,5" FontWeight="Medium"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Thicknesses}"
                 SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                 Margin="0,0,0,10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="5,2"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Độ Dày Tường:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Grid.Column="1" x:Name="TxtThickness"
                     Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,10,0" Padding="2"
                     PreviewTextInput="TxtThickness_PreviewTextInput"/>
            <Button Grid.Column="2" x:Name="BtnPickUp" Content="Chọn" Width="60" Padding="5,2" Click="BtnPickUp_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnOk" Content="OK" Width="70" Margin="0,0,15,0" Padding="5,2" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="Hủy" Width="70" Padding="5,2" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
