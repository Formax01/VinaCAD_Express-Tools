<Window x:Class="Tools.VinaCAD.UI.WallThicknessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
        xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
        Title="{x:Static res:Lang.WWT_UI_DoDayTuong}"
        Height="450" Width="360"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Lang.WWT_UI_DanhSachDoDayTuong}" Margin="0,0,0,5" FontWeight="Medium"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Thicknesses}"
                 SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                 Margin="0,0,0,10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0,2,10,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Static res:Lang.WWT_UI_DoDayTuong_63076923}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Grid.Column="1" x:Name="TxtThickness"
                     Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,10,0" Padding="2"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="TxtThickness_PreviewTextInput"
                     behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"/>
            <Button Grid.Column="2" x:Name="BtnPickUp" Content="{x:Static res:Lang.WWT_UI_Chon}" Width="60" Padding="5,2" Click="BtnPickUp_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="{x:Static res:Lang.WWT_UI_DongY}" Width="60" Margin="0,0,10,0" Padding="5,2" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="{x:Static res:Lang.Common_UI_Huy}" Width="60" Padding="5,2" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
