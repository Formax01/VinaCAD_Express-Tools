<Window x:Class="Tools.View.UI.AciPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behavior="clr-namespace:Tools.View.Behaviors"
        Title="Chọn màu (ACI)"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        behavior:WindowDialogBehavior.DialogResult="{Binding DialogResult, Mode=OneWay}">
    <Window.Resources>
        <DataTemplate x:Key="ColorCellTemplate">
            <Button Width="18" Height="14" Padding="0" Margin="0.5"
                    Background="{Binding ColorBrush}"
                    BorderThickness="2"
                    ToolTip="{Binding Description}"
                    Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="StandardColorCellTemplate">
            <Button Width="26" Height="22" Padding="0" Margin="0.5"
                    Background="{Binding ColorBrush}"
                    BorderThickness="2"
                    ToolTip="{Binding Description}"
                    Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="AutoCAD Color Index (ACI):" Margin="0,0,0,4"/>

        <ItemsControl ItemsSource="{Binding DarkColors}" ItemTemplate="{StaticResource ColorCellTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="24" Rows="5"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding LightColors}" ItemTemplate="{StaticResource ColorCellTemplate}" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="24" Rows="5"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding StandardColors}" ItemTemplate="{StaticResource StandardColorCellTemplate}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Index color:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="50" Padding="3,2" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}"/>
            <Border Width="44" Height="26" BorderBrush="Gray" BorderThickness="1" Margin="8,0,0,0"
                    Background="{Binding PreviewBrush}"/>
            <TextBlock Text="{Binding Description}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Padding="0,3" IsDefault="True"
                    IsEnabled="{Binding CanAccept}" Command="{Binding AcceptCommand}"/>
            <Button Content="Cancel" Width="80" Padding="0,3" Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
