<Window
    x:Class="Tools.View.UI.DanhSoHieuTKTDWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tools.View.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    Title="{x:Static res:Lang.TD_UI_DanhSoHieuVaThongKeThepDauDamPcTuDong}"
    Loaded="BangToaDoCocWindow_Loaded"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="10" />
                <RowDefinition Height="25" />
                <RowDefinition Height="10" />
                <RowDefinition Height="25" />
                <RowDefinition Height="10" />
                <RowDefinition Height="25" />
                <RowDefinition Height="10" />
                <RowDefinition Height="25" />
                <RowDefinition Height="10" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.ColumnSpan="3"
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.TD_UI_XacLapDanhSoHieuThepTuDong}" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.Common_UI_QuyTacDanhSoHieu}" />

            <RadioButton
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="{x:Static res:Lang.Common_UI_TraiSangPhai}"
                GroupName="NumberRule"
                IsChecked="{Binding IsLeftToRight}" />

            <RadioButton
                Grid.Row="2"
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{x:Static res:Lang.Common_UI_TrenXuongDuoi}"
                GroupName="NumberRule"
                IsChecked="{Binding IsTopToBottom}" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.TD_UI_SoHieuBatDauCoDinhChoLoaiThepRen}" />

            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Width="100"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                Foreground="Red"
                Text="{Binding SoHieuThepRenStart, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.TD_UI_ChieuDaiCongThemPhanTienRenMm}" />

            <TextBox
                Grid.Row="6"
                Grid.Column="1"
                Width="100"
                HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center"
                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                Foreground="Red"
                Text="{Binding ChieuDaiCongThemTienRen, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.TD_UI_SoHieuBatDauCoDinhChoLoaiThepKhac}" />

            <TextBox
                Grid.Row="8"
                Grid.Column="1"
                Width="100"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                Foreground="Red"
                Text="{Binding SoHieuThepKhacStart, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Row="10"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.Common_UI_TyLeBanVe}" />

            <TextBox
                Grid.Row="10"
                Grid.Column="1"
                Width="100"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                Foreground="Red"
                Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="100"
                Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding DanhSoCmd}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.Common_UI_DanhSoHieuTuDong}"
                    TextAlignment="Center" />
            </Button>

            <Button
                Grid.Column="1"
                Width="100"
                Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding DrawTableCmd}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.Common_UI_VeBangThongKeThep}"
                    TextAlignment="Center" />
            </Button>

            <Button
                Grid.Column="2"
                Width="100"
                Height="40"
                HorizontalContentAlignment="Center"
                Command="{Binding CancelCmd}"
                Content="{x:Static res:Lang.Common_UI_Thoat}" />
        </Grid>
    </Grid>
</Window>
