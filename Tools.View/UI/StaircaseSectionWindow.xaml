<Window
    x:Class="Tools.View.UI.StaircaseSectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vẽ mặt cắt cầu thang"
    Width="8 00"
    Height="440"
    Background="#F0F0F0"
    FontFamily="Segoe UI"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="570" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="225" />
                <RowDefinition Height="36" />
                <RowDefinition Height="1" />
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Content="Cầu thang 2 vế" GroupName="StairType" IsChecked="{Binding IsDoubleFlight}" />
                <RadioButton Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" Content="Cầu thang 1 vế" GroupName="StairType" IsChecked="{Binding IsSingleFlight}" />
                <RadioButton Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Content="Cầu thang chữ X" GroupName="StairType" IsChecked="{Binding IsScissor}" />
            </Grid>

            <Canvas Grid.Row="1" Width="570" Height="225" ClipToBounds="True">
                <!-- DOUBLE TREAD -->
                <Canvas Width="185" Height="225" Canvas.Left="0">
                    <Line X1="42" Y1="174" X2="75" Y2="174" Stroke="Black" StrokeThickness="1" />
                    <Polyline Points="42,174 42,166 50,166 50,160 58,160 58,154 66,154 66,148 74,148 74,142 82,142 82,136 90,136 90,130 98,130 98,124 106,124" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Line X1="106" Y1="124" X2="147" Y2="124" Stroke="Black" StrokeThickness="1" />
                    <Line X1="147" Y1="124" X2="147" Y2="132" Stroke="Black" StrokeThickness="1" />
                    <Line X1="147" Y1="132" X2="111" Y2="132" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="174" X2="42" Y2="182" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="182" X2="75" Y2="182" Stroke="Black" StrokeThickness="1" />
                    <Line X1="75" Y1="182" X2="75" Y2="174" Stroke="Black" StrokeThickness="1" />
                    <Line X1="74" Y1="118" X2="139" Y2="83" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="74" Y1="142" X2="139" Y2="107" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="74" Y1="118" X2="74" Y2="142" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="139" Y1="83" X2="139" Y2="107" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="96" X2="75" Y2="96" Stroke="Black" StrokeThickness="1" />
                    <Polyline Points="42,96 42,88 50,88 50,82 58,82 58,76 66,76 66,70 74,70 74,64 82,64 82,58 90,58 90,52 98,52 98,46 106,46" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Line X1="106" Y1="46" X2="147" Y2="46" Stroke="Black" StrokeThickness="1" />
                    <Line X1="147" Y1="46" X2="147" Y2="54" Stroke="Black" StrokeThickness="1" />
                    <Line X1="147" Y1="54" X2="111" Y2="54" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="96" X2="42" Y2="104" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="104" X2="75" Y2="104" Stroke="Black" StrokeThickness="1" />
                    <Line X1="74" Y1="40" X2="139" Y2="5" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="74" Y1="64" X2="139" Y2="29" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="74" Y1="40" X2="74" Y2="64" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="139" Y1="5" X2="139" Y2="29" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="25" Y1="45" X2="25" Y2="174" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="20" Y1="45" X2="30" Y2="45" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="20" Y1="174" X2="30" Y2="174" Stroke="#33A51C" StrokeThickness="1" />
                    <TextBlock Canvas.Left="4" Canvas.Top="115" FontSize="11" Text="Chiều cao tầng" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform Angle="-90" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <Line X1="43" Y1="184" X2="43" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="39" Y1="195" X2="43" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="47" Y1="195" X2="43" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <TextBlock Canvas.Left="6" Canvas.Top="190" FontSize="10" Text="Điểm chèn" />
                    <TextBlock Canvas.Left="45" Canvas.Top="174" FontSize="10" Text="Chiếu nghỉ 1" />
                    <TextBlock Canvas.Left="111" Canvas.Top="104" FontSize="10" Text="Chiếu nghỉ 2" />
                    <TextBlock Canvas.Left="54" Canvas.Top="207" FontFamily="Arial Narrow" FontSize="14" Text="THANG 2 VẾ" />
                </Canvas>

                <!-- SINGLE TREAD -->
                <Canvas Width="190" Height="225" Canvas.Left="185">
                    <Line X1="5" Y1="174" X2="42" Y2="174" Stroke="Black" StrokeThickness="1" />
                    <Line X1="5" Y1="174" X2="5" Y2="182" Stroke="Black" StrokeThickness="1" />
                    <Line X1="5" Y1="182" X2="42" Y2="182" Stroke="Black" StrokeThickness="1" />
                    <Polyline Points="42,174 42,169 50,169 50,164 58,164 58,159 66,159 66,154 74,154 74,149 82,149 82,144 90,144 90,139 98,139 98,134 106,134 106,129 114,129 114,124 122,124 122,119 130,119" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Line X1="130" Y1="119" X2="168" Y2="119" Stroke="Black" StrokeThickness="1" />
                    <Line X1="168" Y1="119" X2="168" Y2="127" Stroke="Black" StrokeThickness="1" />
                    <Line X1="168" Y1="127" X2="136" Y2="127" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="174" X2="130" Y2="119" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="144" X2="130" Y2="89" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="144" X2="42" Y2="174" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="130" Y1="89" X2="130" Y2="119" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="5" Y1="96" X2="42" Y2="96" Stroke="Black" StrokeThickness="1" />
                    <Line X1="5" Y1="96" X2="5" Y2="104" Stroke="Black" StrokeThickness="1" />
                    <Line X1="5" Y1="104" X2="42" Y2="104" Stroke="Black" StrokeThickness="1" />
                    <Polyline Points="42,96 42,91 50,91 50,86 58,86 58,81 66,81 66,76 74,76 74,71 82,71 82,66 90,66 90,61 98,61 98,56 106,56 106,51 114,51 114,46 122,46 122,41 130,41" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Line X1="130" Y1="41" X2="168" Y2="41" Stroke="Black" StrokeThickness="1" />
                    <Line X1="168" Y1="41" X2="168" Y2="49" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="96" X2="130" Y2="41" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="66" X2="130" Y2="11" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="66" X2="42" Y2="96" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="130" Y1="11" X2="130" Y2="41" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="6" Y1="184" X2="6" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="2" Y1="195" X2="6" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="10" Y1="195" X2="6" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <TextBlock Canvas.Left="7" Canvas.Top="174" FontSize="10" Text="Chiếu nghỉ 1" />
                    <TextBlock Canvas.Left="7" Canvas.Top="190" FontSize="10" Text="Điểm chèn" />
                    <TextBlock Canvas.Left="115" Canvas.Top="99" FontSize="10" Text="Chiếu nghỉ 2" />
                    <TextBlock Canvas.Left="55" Canvas.Top="183" FontSize="10" Text="Dầm 1" />
                    <TextBlock Canvas.Left="132" Canvas.Top="129" FontSize="10" Text="Dầm 2" />
                    <TextBlock Canvas.Left="54" Canvas.Top="207" FontFamily="Arial Narrow" FontSize="14" Text="THANG 1 VẾ" />
                </Canvas>

                <!-- SCISSORS STAIRCASE -->
                <Canvas Width="195" Height="225" Canvas.Left="375">
                    <Line X1="12" Y1="174" X2="42" Y2="174" Stroke="Black" StrokeThickness="1" />
                    <Line X1="12" Y1="174" X2="12" Y2="182" Stroke="Black" StrokeThickness="1" />
                    <Line X1="12" Y1="182" X2="42" Y2="182" Stroke="Black" StrokeThickness="1" />
                    <Polyline Points="42,174 42,168 50,168 50,162 58,162 58,156 66,156 66,150 74,150 74,144 82,144 82,138 90,138 90,132 98,132 98,126 106,126" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Polyline Points="140,174 140,168 132,168 132,162 124,162 124,156 116,156 116,150 108,150 108,144 100,144 100,138 92,138 92,132 84,132 84,126 76,126" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Line X1="106" Y1="126" X2="170" Y2="126" Stroke="Black" StrokeThickness="1" />
                    <Line X1="170" Y1="126" X2="170" Y2="134" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="174" X2="140" Y2="112" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="140" Y1="174" X2="42" Y2="112" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="145" X2="140" Y2="83" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="140" Y1="145" X2="42" Y2="83" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="12" Y1="96" X2="42" Y2="96" Stroke="Black" StrokeThickness="1" />
                    <Line X1="12" Y1="96" X2="12" Y2="104" Stroke="Black" StrokeThickness="1" />
                    <Line X1="12" Y1="104" X2="42" Y2="104" Stroke="Black" StrokeThickness="1" />
                    <Polyline Points="42,96 42,90 50,90 50,84 58,84 58,78 66,78 66,72 74,72 74,66 82,66 82,60 90,60 90,54 98,54 98,48 106,48" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Polyline Points="140,96 140,90 132,90 132,84 124,84 124,78 116,78 116,72 108,72 108,66 100,66 100,60 92,60 92,54 84,54 84,48 76,48" Stroke="Black" StrokeThickness="1" Fill="Transparent" />
                    <Line X1="106" Y1="48" X2="170" Y2="48" Stroke="Black" StrokeThickness="1" />
                    <Line X1="170" Y1="48" X2="170" Y2="56" Stroke="Black" StrokeThickness="1" />
                    <Line X1="42" Y1="96" X2="140" Y2="34" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="140" Y1="96" X2="42" Y2="34" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="42" Y1="67" X2="140" Y2="5" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="140" Y1="67" X2="42" Y2="5" Stroke="#008E9B" StrokeThickness="1" />
                    <Line X1="13" Y1="184" X2="13" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="9" Y1="195" X2="13" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <Line X1="17" Y1="195" X2="13" Y2="199" Stroke="#33A51C" StrokeThickness="1" />
                    <TextBlock Canvas.Left="14" Canvas.Top="174" FontSize="10" Text="Chiếu nghỉ 1" />
                    <TextBlock Canvas.Left="14" Canvas.Top="190" FontSize="10" Text="Điểm chèn" />
                    <TextBlock Canvas.Left="120" Canvas.Top="106" FontSize="10" Text="Chiếu nghỉ 2" />
                    <TextBlock Canvas.Left="52" Canvas.Top="183" FontSize="10" Text="Dầm 1" />
                    <TextBlock Canvas.Left="132" Canvas.Top="135" FontSize="10" Text="Dầm 2" />
                    <TextBlock Canvas.Left="49" Canvas.Top="207" FontFamily="Arial Narrow" FontSize="14" Text="THANG CHỮ X" />
                </Canvas>
            </Canvas>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Content="Vế đầu sang trái" GroupName="Direction" IsChecked="{Binding FirstRunLeftward}" />
                <RadioButton Grid.Column="1" Grid.ColumnSpan="2" Margin="105,0,0,0" VerticalAlignment="Center" Content="Vế đầu sang phải" GroupName="Direction" IsChecked="{Binding FirstRunRightward}" />
            </Grid>

            <Border Grid.Row="3" Background="#D0D0D0" />

            <GroupBox Grid.Row="4" Header="Thông số chiếu nghỉ:">
                <Grid Margin="3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiếu nghỉ 1:" ToolTip="Chiều rộng chiếu nghỉ 1" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Landing1Width, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding MeasureLanding1WidthCmd}" Content="Đo" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" Text="Dầm chính C:" ToolTip="Chiều cao dầm chính" />
                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding GirderHeight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <TextBlock Grid.Row="0" Grid.Column="5" Margin="8,0,0,0" Text="Dầm phụ C:" ToolTip="Chiều cao dầm phụ" />
                    <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding BeamHeight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <CheckBox Grid.Row="0" Grid.Column="7" Margin="8,0,0,0" VerticalAlignment="Center" Content="Dầm 1" IsChecked="{Binding HasBeam1}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Chiếu nghỉ 2:" ToolTip="Chiều rộng chiếu nghỉ 2" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Landing2Width, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding MeasureLanding2WidthCmd}" Content="Đo" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" Text="Dầm chính R:" ToolTip="Chiều rộng dầm chính" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding GirderWidth, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <TextBlock Grid.Row="1" Grid.Column="5" Margin="8,0,0,0" Text="Dầm phụ R:" ToolTip="Chiều rộng dầm phụ" />
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding BeamWidth, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <CheckBox Grid.Row="1" Grid.Column="7" Margin="8,0,0,0" VerticalAlignment="Center" Content="Dầm 2" IsChecked="{Binding HasBeam2}" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Width="62" Margin="0,0,28,0" Command="{Binding AcceptCmd}" Content="Đồng ý" IsDefault="True" />
                <Button Width="54" Command="{Binding CancelCmd}" Content="Hủy" IsCancel="True" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Column="2" Header="Thông số cầu thang:">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiều cao tầng:" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StoreyHeight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <Button Grid.Row="0" Grid.Column="2" Command="{Binding MeasureStoreyHeightCmd}" Content="Đo" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Số tầng:" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding StoreyNumber, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Chiều rộng mặt bậc:" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding TreadRun, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tổng số bậc:" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding StepNumber, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Số bậc vế thứ nhất:" />
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding FirstFlightStepNumber, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding CurrentStepHeight, StringFormat=Chiều cao cổ bậc hiện tại: {0:0.####}}" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Chiều dày bản thang:" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding BoardThickness, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Chiều cao lan can:" />
                <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding RailingHeight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Content="Tạo nhóm" IsChecked="{Binding CreateGroup}" />
                <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Height="23" VerticalAlignment="Top" Command="{Binding ResetCmd}" Content="Khôi phục giá trị mặc định" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
