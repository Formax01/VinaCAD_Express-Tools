<Window
    x:Class="Tools.View.UI.StaircaseSectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vẽ mặt cắt cầu thang"
    Width="1020"
    Height="510"
    Background="#F0F0F0"
    FontFamily="Segoe UI"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="690" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="290" />
                <RowDefinition Height="36" />
                <RowDefinition Height="1" />
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Content="Cầu thang 2 vế" GroupName="StairType" IsChecked="{Binding IsDoubleFlight}" />
                <RadioButton Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" Content="Cầu thang 1 vế" GroupName="StairType" IsChecked="{Binding IsSingleFlight}" />
                <RadioButton Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Content="Cầu thang chữ X" GroupName="StairType" IsChecked="{Binding IsScissor}" />
            </Grid>

            <Canvas Grid.Row="1" Width="690" Height="290" ClipToBounds="True">
                <Canvas x:Name="DoublePreviewCanvas" Width="230" Height="290" Canvas.Left="0" ClipToBounds="True">
                    <Path x:Name="DoublePreviewPath" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                    <Canvas x:Name="DoubleDimensionCanvas" Width="230" Height="240" IsHitTestVisible="False" />
                    <Ellipse Width="5" Height="5" Fill="#33A51C" IsHitTestVisible="False" />
                    <TextBlock Canvas.Left="72" Canvas.Top="242" FontSize="14" FontWeight="SemiBold" Text="THANG 2 VẾ" />
                    <TextBlock Canvas.Left="7" Canvas.Top="262" Foreground="#22802A" FontSize="10" Text="● Điểm chèn" />
                    <TextBlock x:Name="DoublePreviewSummary" Canvas.Left="106" Canvas.Top="262" Width="118" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Canvas>

                <Canvas x:Name="SinglePreviewCanvas" Width="230" Height="290" Canvas.Left="230" ClipToBounds="True">
                    <Path x:Name="SinglePreviewPath" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                    <Canvas x:Name="SingleDimensionCanvas" Width="230" Height="240" IsHitTestVisible="False" />
                    <Ellipse Width="5" Height="5" Fill="#33A51C" IsHitTestVisible="False" />
                    <TextBlock Canvas.Left="72" Canvas.Top="242" FontSize="14" FontWeight="SemiBold" Text="THANG 1 VẾ" />
                    <TextBlock Canvas.Left="7" Canvas.Top="262" Foreground="#22802A" FontSize="10" Text="● Điểm chèn" />
                    <TextBlock x:Name="SinglePreviewSummary" Canvas.Left="106" Canvas.Top="262" Width="118" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Canvas>

                <Canvas x:Name="ScissorPreviewCanvas" Width="230" Height="290" Canvas.Left="460" ClipToBounds="True">
                    <Path x:Name="ScissorPreviewPath" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                    <Canvas x:Name="ScissorDimensionCanvas" Width="230" Height="240" IsHitTestVisible="False" />
                    <Ellipse Width="5" Height="5" Fill="#33A51C" IsHitTestVisible="False" />
                    <TextBlock Canvas.Left="65" Canvas.Top="242" FontSize="14" FontWeight="SemiBold" Text="THANG CHỮ X" />
                    <TextBlock Canvas.Left="7" Canvas.Top="262" Foreground="#22802A" FontSize="10" Text="● Điểm chèn" />
                    <TextBlock x:Name="ScissorPreviewSummary" Canvas.Left="106" Canvas.Top="262" Width="118" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Canvas>
            </Canvas>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Content="Vế đầu sang trái" GroupName="Direction" IsChecked="{Binding FirstRunLeftward}" />
                <RadioButton Grid.Column="1" Grid.ColumnSpan="2" Margin="105,0,0,0" VerticalAlignment="Center" Content="Vế đầu sang phải" GroupName="Direction" IsChecked="{Binding FirstRunRightward}" />
            </Grid>

            <Border Grid.Row="3" Background="#D0D0D0" />

            <GroupBox Grid.Row="4" Header="Thông số chiếu nghỉ:">
                <Grid Margin="3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiếu nghỉ 1:" ToolTip="Chiều rộng chiếu nghỉ 1" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Landing1Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding MeasureLanding1WidthCmd}" Content="Đo" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" Text="Dầm chính C:" ToolTip="Chiều cao dầm chính" />
                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding GirderHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <TextBlock Grid.Row="0" Grid.Column="5" Margin="8,0,0,0" Text="Dầm phụ C:" ToolTip="Chiều cao dầm phụ" />
                    <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding BeamHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <CheckBox Grid.Row="0" Grid.Column="7" Margin="8,0,0,0" VerticalAlignment="Center" Content="Dầm 1" IsChecked="{Binding HasBeam1}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Chiếu nghỉ 2:" ToolTip="Chiều rộng chiếu nghỉ 2" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Landing2Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding MeasureLanding2WidthCmd}" Content="Đo" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" Text="Dầm chính R:" ToolTip="Chiều rộng dầm chính" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding GirderWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <TextBlock Grid.Row="1" Grid.Column="5" Margin="8,0,0,0" Text="Dầm phụ R:" ToolTip="Chiều rộng dầm phụ" />
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding BeamWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <CheckBox Grid.Row="1" Grid.Column="7" Margin="8,0,0,0" VerticalAlignment="Center" Content="Dầm 2" IsChecked="{Binding HasBeam2}" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Width="62" Margin="0,0,28,0" Command="{Binding AcceptCmd}" Content="Đồng ý" IsDefault="True" />
                <Button Width="54" Command="{Binding CancelCmd}" Content="Hủy" IsCancel="True" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Column="2" Header="Thông số cầu thang:">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiều cao tầng:" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StoreyHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <Button Grid.Row="0" Grid.Column="2" Command="{Binding MeasureStoreyHeightCmd}" Content="Đo" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Số tầng:" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding StoreyNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Chiều rộng mặt bậc:" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding TreadRun, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tổng số bậc:" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding StepNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Số bậc vế thứ nhất:" />
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding FirstFlightStepNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding CurrentStepHeight, StringFormat=Chiều cao cổ bậc hiện tại: {0:0.####}}" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Chiều dày bản thang:" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding BoardThickness, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Chiều cao lan can:" />
                <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding RailingHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Content="Tạo nhóm" IsChecked="{Binding CreateGroup}" />
                <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Height="23" VerticalAlignment="Top" Command="{Binding ResetCmd}" Content="Khôi phục giá trị ban đầu" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
