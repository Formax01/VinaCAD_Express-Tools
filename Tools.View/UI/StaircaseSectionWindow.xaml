<Window
    x:Class="Tools.View.UI.StaircaseSectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Tools.View.Behaviors" 
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    Title="{x:Static res:Lang.Common_Text_VeMatCatCauThang}"
    Width="1020"
    Height="525"
    Background="#F0F0F0"
    FontFamily="Segoe UI"
    FontSize="12"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="behaviors:TextBoxBehavior.SelectAllTextOnFocus" Value="True" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="22" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="690" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="290" />
                <RowDefinition Height="36" />
                <RowDefinition Height="1" />
                <RowDefinition Height="85" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="230" />

                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_CauThang2Ve}" GroupName="StairType" IsChecked="{Binding IsDoubleFlight}" />
                <RadioButton Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_CauThang1Ve}" GroupName="StairType" IsChecked="{Binding IsSingleFlight}" />
                <RadioButton Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_CauThangChuX}" GroupName="StairType" IsChecked="{Binding IsScissor}" />
            </Grid>

            <Canvas Grid.Row="1" Width="690" Height="290" ClipToBounds="True">
                <Canvas x:Name="DoublePreviewCanvas" Width="230" Height="290" Canvas.Left="0" ClipToBounds="True">
                    <Path x:Name="DoublePreviewPath" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                    <Canvas x:Name="DoubleDimensionCanvas" Width="230" Height="240" IsHitTestVisible="False" />
                    <Ellipse Width="5" Height="5" Fill="#33A51C" IsHitTestVisible="False" />
                    <TextBlock Canvas.Left="0" Canvas.Top="242" Width="230" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Lang.LTP_UI_Thang2Ve}" />
                    <TextBlock Canvas.Left="7" Canvas.Top="262" Foreground="#22802A" FontSize="10" Text="{x:Static res:Lang.LTP_UI_DiemChen}" />
                    <TextBlock x:Name="DoublePreviewSummary" Canvas.Left="106" Canvas.Top="262" Width="118" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Canvas>

                <Canvas x:Name="SinglePreviewCanvas" Width="230" Height="290" Canvas.Left="230" ClipToBounds="True">
                    <Path x:Name="SinglePreviewPath" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                    <Canvas x:Name="SingleDimensionCanvas" Width="230" Height="240" IsHitTestVisible="False" />
                    <Ellipse Width="5" Height="5" Fill="#33A51C" IsHitTestVisible="False" />
                    <TextBlock Canvas.Left="0" Canvas.Top="242" Width="230" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Lang.LTP_UI_Thang1Ve}" />
                    <TextBlock Canvas.Left="7" Canvas.Top="262" Foreground="#22802A" FontSize="10" Text="{x:Static res:Lang.LTP_UI_DiemChen}" />
                    <TextBlock x:Name="SinglePreviewSummary" Canvas.Left="106" Canvas.Top="262" Width="118" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Canvas>

                <Canvas x:Name="ScissorPreviewCanvas" Width="230" Height="290" Canvas.Left="460" ClipToBounds="True">
                    <Path x:Name="ScissorPreviewPath" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                    <Canvas x:Name="ScissorDimensionCanvas" Width="230" Height="240" IsHitTestVisible="False" />
                    <Ellipse Width="5" Height="5" Fill="#33A51C" IsHitTestVisible="False" />
                    <TextBlock Canvas.Left="0" Canvas.Top="242" Width="230" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Lang.LTP_UI_ThangChuX}" />
                    <TextBlock Canvas.Left="7" Canvas.Top="262" Foreground="#22802A" FontSize="10" Text="{x:Static res:Lang.LTP_UI_DiemChen}" />
                    <TextBlock x:Name="ScissorPreviewSummary" Canvas.Left="106" Canvas.Top="262" Width="118" FontSize="10" TextTrimming="CharacterEllipsis" />
                </Canvas>
            </Canvas>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_VeDauSangTrai}" GroupName="Direction" IsChecked="{Binding FirstRunLeftward}" />
                <RadioButton Grid.Column="1" Grid.ColumnSpan="2" Margin="105,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_VeDauSangPhai}" GroupName="Direction" IsChecked="{Binding FirstRunRightward}" />
            </Grid>

            <Border Grid.Row="3" Background="#D0D0D0" />

            <GroupBox Grid.Row="4" Header="{x:Static res:Lang.LTP_UI_ThongSoChieuNghi}">
                <Grid HorizontalAlignment="Center" Width="673">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="29" />
                        <RowDefinition Height="29" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5,0,5,0" Text="{x:Static res:Lang.LTP_UI_ChieuNghi1}" ToolTip="{x:Static res:Lang.LTP_UI_ChieuRongChieuNghi1}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,5,0" Text="{Binding Landing1Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="5,0,5,0" Command="{Binding MeasureLanding1WidthCmd}" Content="{x:Static res:Lang.LTP_UI_Do}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="5,0,5,0" Text="{x:Static res:Lang.LTP_UI_DamChinhC}" ToolTip="{x:Static res:Lang.LTP_UI_ChieuCaoDamChinh}" />
                    <TextBox Grid.Row="0" Grid.Column="4" Margin="0,0,5,0" Text="{Binding GirderHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <TextBlock Grid.Row="0" Grid.Column="5" Margin="5,0,5,0" Text="{x:Static res:Lang.LTP_UI_DamPhuC}" ToolTip="{x:Static res:Lang.LTP_UI_ChieuCaoDamPhu}" />
                    <TextBox Grid.Row="0" Grid.Column="6" Margin="0,0,5,0" Text="{Binding BeamHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <CheckBox Grid.Row="0" Grid.Column="7" Margin="5,0,5,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_Text_Dam1}" IsChecked="{Binding HasBeam1}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="5,0,5,0" Text="{x:Static res:Lang.LTP_UI_ChieuNghi2}" ToolTip="{x:Static res:Lang.LTP_UI_ChieuRongChieuNghi2}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,5,0" Text="{Binding Landing2Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="5,0,5,0" Command="{Binding MeasureLanding2WidthCmd}" Content="{x:Static res:Lang.LTP_UI_Do}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="5,0,5,0" Text="{x:Static res:Lang.LTP_UI_DamChinhR}" ToolTip="{x:Static res:Lang.LTP_UI_ChieuRongDamChinh}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Margin="0,0,5,0" Text="{Binding GirderWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <TextBlock Grid.Row="1" Grid.Column="5" Margin="5,0,5,0" Text="{x:Static res:Lang.LTP_UI_DamPhuR}" ToolTip="{x:Static res:Lang.LTP_UI_ChieuRongDamPhu}" />
                    <TextBox Grid.Row="1" Grid.Column="6" Margin="0,0,5,0" Text="{Binding BeamWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                    <CheckBox Grid.Row="1" Grid.Column="7" Margin="5,0,5,0" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_Text_Dam2}" IsChecked="{Binding HasBeam2}" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Width="76" Height="25" Margin="0,0,10,0" Command="{Binding AcceptCmd}" Content="{x:Static res:Lang.LTP_UI_DongY}" IsDefault="True" />
                <Button Width="76" Height="25" Margin="0,0,0,0" Command="{Binding CancelCmd}" Content="{x:Static res:Lang.Common_UI_Huy}" IsCancel="True" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Column="2" Margin="0" Header="{x:Static res:Lang.LTP_UI_ThongSoCauThang}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_ChieuCaoTang}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,5,0" Text="{Binding StoreyHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />
                <Button Grid.Row="0" Grid.Column="2" Margin="5,0,0,0" Command="{Binding MeasureStoreyHeightCmd}" Content="{x:Static res:Lang.LTP_UI_Do}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_SoTang}" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StoreyNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_ChieuRongMatBac}" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TreadRun, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_TongSoBac}" />
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StepNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_SoBacVeThuNhat}" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FirstFlightStepNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding CurrentStepHeightText}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_ChieuDayBanThang}" />
                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding BoardThickness, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="{x:Static res:Lang.LTP_UI_ChieuCaoLanCan}" />
                <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RailingHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=0.####}" />

                <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_TaoNhom}" IsChecked="{Binding CreateGroup}" />
                <CheckBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Content="{x:Static res:Lang.LTP_UI_GhepNhomSauKhiVe}" IsChecked="{Binding JoinGroupAfterDraw}" IsEnabled="{Binding CreateGroup}" />

                <Button Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Height="23" VerticalAlignment="Center" Command="{Binding ResetCmd}" Content="{x:Static res:Lang.LTP_UI_KhoiPhucGiaTriBanDau}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
