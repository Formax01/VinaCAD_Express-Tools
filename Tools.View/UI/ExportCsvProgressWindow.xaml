<Window
    x:Class="Tools.View.UI.ExportCsvProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CSV エクスポート"
    Width="560"
    Height="150"
    MinWidth="480"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="txtStage"
            FontSize="16"
            FontWeight="SemiBold"
            Text="CSV エクスポートを準備しています..."
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="txtFileName"
            Grid.Row="1"
            Height="22"
            Margin="0,8,0,0"
            Foreground="#FF555555"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

        <Grid
            Grid.Row="2"
            Height="24"
            Margin="0,10,0,0">

            <ProgressBar
                x:Name="progressBar"
                IsIndeterminate="True"
                Maximum="100"
                Minimum="0" />

            <TextBlock
                x:Name="txtPercentage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="#FF202020"
                IsHitTestVisible="False"
                Text="処理中..." />
        </Grid>
    </Grid>
</Window>
