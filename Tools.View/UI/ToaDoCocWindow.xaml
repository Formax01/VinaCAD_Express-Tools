<Window
    x:Class="Tools.View.UI.ToaDoCocWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tools.View.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    Title="{x:Static res:Lang.TDC_UI_XacLapToaDoCoc}"
    Width="400"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Static res:Lang.TDC_UI_KCachLechChoPhepGiuaCocVaKiHieuCoc}"
                TextWrapping="Wrap" />
            <TextBox
                Grid.Column="1"
                Height="30"
                HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center"
                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                Text="{Binding CheckDistance, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Lang.Common_UI_TyLeBanVe}" />

            <TextBox
                Grid.Column="1"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">

            <Button
                Width="70"
                Height="25"
                Margin="0,0,90,0"
                Command="{Binding SelectPileCmd}"
                Content="{x:Static res:Lang.Common_UI_QuetChon}" />

            <Button
                Width="70"
                Height="25"
                Command="{Binding CancelCmd}"
                Content="{x:Static res:Lang.Common_UI_Thoat}" />
        </StackPanel>
    </Grid>
</Window>
