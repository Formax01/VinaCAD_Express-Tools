<Window x:Class="Tools.View.UI.BanisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behavior="clr-namespace:Tools.View.Behaviors"
        xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
        Title="{x:Static res:Lang.LG_Title_LanCan}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        behavior:WindowDialogBehavior.DialogResult="{Binding DialogResult, Mode=OneWay}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <!-- Style riêng cho nút OK để làm nổi bật Primary Action -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Cột trái: hình minh họa ===== -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <Canvas x:Name="SlopedCanvas" Width="175" Height="165"/>
            <Canvas x:Name="FlatCanvas" Width="175" Height="85" Margin="0,16,0,0"/>
            <CheckBox Margin="0,12,0,0"
                      Content="{x:Static res:Lang.LG_UI_ToGroup}"
                      IsChecked="{Binding ToGroup}"
                      ToolTip="{x:Static res:Lang.LG_TT_ToGroup}"/>
        </StackPanel>

        <!-- ===== Cột phải: các ô nhập ===== -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0">
                <Run Text="{x:Static res:Lang.LG_UI_BanisterLayer}"/><Run Text=":"/>
            </TextBlock>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" IsEditable="True"
                      ItemsSource="{Binding LayerNames}"
                      Text="{Binding LayerName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1">
                <Run Text="{x:Static res:Lang.LG_UI_LayerColor}"/><Run Text=":"/>
            </TextBlock>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="36" Text="{Binding ColorIndex, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Width="28" Height="22" Margin="4,0,4,0"
                        Background="{Binding ColorBrush}"
                        Command="{Binding ChooseColorCmd}"
                        ToolTip="{x:Static res:Lang.LG_TT_ChooseColor}"/>
                <Button Width="40" Margin="0,3"
                        Content="{x:Static res:Lang.LG_UI_Pick}"
                        Command="{Binding PickCmd}"
                        ToolTip="{x:Static res:Lang.LG_TT_Pick}"/>
            </StackPanel>

            <TextBlock Grid.Row="2">
                <Run Text="{x:Static res:Lang.LG_UI_TotalHeight}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TotalHeight, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3">
                <Run Text="{x:Static res:Lang.LG_UI_HandrailDia}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HandrailDia, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4">
                <Run Text="{x:Static res:Lang.LG_UI_HandrailExtend}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HandrailExtend, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5">
                <Run Text="{x:Static res:Lang.LG_UI_RailDia}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RailDia, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6">
                <Run Text="{x:Static res:Lang.LG_UI_TopGap}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TopGap, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="7">
                <Run Text="{x:Static res:Lang.LG_UI_BottomGap}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding BottomGap, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="8">
                <Run Text="{x:Static res:Lang.LG_UI_ColumnDia}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ColumnDia, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="9">
                <Run Text="{x:Static res:Lang.LG_UI_ColumnGap}"/><Run Text=": &lt;="/>
            </TextBlock>
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ColumnGap, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox Grid.Row="10" Grid.ColumnSpan="2" Margin="0,4"
                      Content="{x:Static res:Lang.LG_UI_HasSideColumns}"
                      IsChecked="{Binding HasSideColumns}"/>

            <TextBlock Grid.Row="11">
                <Run Text="{x:Static res:Lang.LG_UI_PoleDia}"/><Run Text=":"/>
            </TextBlock>
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding PoleDia, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="12">
                <Run Text="{x:Static res:Lang.LG_UI_PoleGap}"/><Run Text=": &lt;="/>
            </TextBlock>
            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding PoleGap, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- ===== Hàng nút dưới cùng ===== -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button Width="110" Height="26"
                    HorizontalAlignment="Left"
                    Content="{x:Static res:Lang.LG_UI_ResetDefaults}"
                    Command="{Binding ResetCmd}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Height="26" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Content="{x:Static res:Lang.LG_UI_OK}"
                        Command="{Binding AcceptCmd}"/>
                <Button Width="80" Height="26"
                        IsCancel="True"
                        Content="{x:Static res:Lang.LG_UI_Cancel}"
                        Command="{Binding CancelCmd}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>