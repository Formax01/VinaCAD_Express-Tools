<Window x:Class="Tools.VinaCAD.UI.GridAxisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
        Title="Cài đặt Lưới Trục"
        Height="500" Width="400"
        SizeToContent="Height"
        MinHeight="300" MinWidth="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            BorderBrush="#FFD0D0D0"
            BorderThickness="1"
            Background="#FFFAFAFA"
            Margin="0,0,0,10">
            <Canvas x:Name="PreviewCanvas"
                MinHeight="170"
                SizeChanged="PreviewCanvas_SizeChanged"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Chiều Rộng:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                 x:Name="BreadthsTextBox"
                 behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                 Text="{Binding BreadthsText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Nhịp theo X, ví dụ: 4200 2500 4300 hoặc 4x3600"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Chiều Sâu:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                 x:Name="DepthsTextBox"
                 behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                 Text="{Binding DepthsText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Nhịp theo Y, nhập từ trên xuống dưới"/>
        </Grid>

        <CheckBox Grid.Row="3"
              Content="Vẽ ký hiệu trục + Kích thước"
              IsChecked="{Binding DrawAnnotations, Mode=TwoWay}"
              Margin="0,10,0,0"/>

        <Button Grid.Row="4"
            Content="Cài Đặt Giá Trị Gốc"
            Height="28"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,10"
            Click="ResetButton_Click"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   Text="{Binding ValidationMessage}"
                   Foreground="#FFB42318"
                   FontSize="11"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    Height="28"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Click="OkButton_Click"/>
                <Button Content="Hủy"
                    Width="80"
                    Height="28"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
