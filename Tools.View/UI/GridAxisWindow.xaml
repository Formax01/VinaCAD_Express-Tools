<Window x:Class="Tools.VinaCAD.UI.GridAxisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
        xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
        Title="{x:Static res:Lang.ZXW_UI_CaiDatLuoiTruc}"
        Height="600" Width="420"
        SizeToContent="Height"
        MinHeight="300" MinWidth="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            BorderBrush="#FFD0D0D0"
            BorderThickness="1"
            Background="#FFFAFAFA"
            Margin="0,0,0,10">
            <Canvas x:Name="PreviewCanvasControl"
                MinHeight="170"
                SizeChanged="PreviewCanvas_SizeChanged"/>
        </Border>

        <Grid Grid.Row="1" Margin="5,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static res:Lang.ZXW_UI_ChieuRong}" VerticalAlignment="Center" TextAlignment="Left" />
            <TextBox Grid.Column="1" Height="25"
                 x:Name="BreadthsTextBoxControl"
                 behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                 Text="{Binding BreadthsText, UpdateSourceTrigger=PropertyChanged}"
                 TextAlignment="Left"
                 ToolTip="{x:Static res:Lang.ZXW_UI_NhipTheoXViDu420025004300Hoac4x3600}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="5,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static res:Lang.ZXW_UI_ChieuSau}" VerticalAlignment="Center" TextAlignment="Left" />
            <TextBox Grid.Column="1" Height="25"
                 x:Name="DepthsTextBox"
                 behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                 Text="{Binding DepthsText, UpdateSourceTrigger=PropertyChanged}"
                 TextAlignment="Left"
                 ToolTip="{x:Static res:Lang.ZXW_UI_NhipTheoYNhapTuTrenXuongDuoi}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Lang.ZXW_UI_TrucTung}" VerticalAlignment="Center" TextAlignment="Left"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Width="95" Height="25" HorizontalAlignment="Left"
                      ItemsSource="{Binding LabelTypes}"
                      SelectedItem="{Binding VerticalAxisLabelType, Mode=TwoWay}"
                      HorizontalContentAlignment="Left" Margin="0,5,5,5"/>
            <TextBox Grid.Row="0" Grid.Column="3" Height="25" VerticalContentAlignment="Center" TextAlignment="Left"
                     Text="{Binding VerticalAxisStart, UpdateSourceTrigger=PropertyChanged}"
                     behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                     ToolTip="{x:Static res:Lang.ZXW_UI_SoHoacChuBatDauCuaTrucTung}" Margin="5,5,0,5"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Lang.ZXW_UI_TrucHoanh}" VerticalAlignment="Center" TextAlignment="Left"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Width="95" Height="25" HorizontalAlignment="Left"
                      ItemsSource="{Binding LabelTypes}"
                      SelectedItem="{Binding HorizontalAxisLabelType, Mode=TwoWay}"
                      HorizontalContentAlignment="Left" Margin="0,5,5,5"/>
            <TextBox Grid.Row="1" Grid.Column="3" Height="25" VerticalContentAlignment="Center" TextAlignment="Left"
                     Text="{Binding HorizontalAxisStart, UpdateSourceTrigger=PropertyChanged}"
                     behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                     ToolTip="{x:Static res:Lang.ZXW_UI_SoHoacChuBatDauCuaTrucHoanh}" Margin="5,5,0,5"/>
        </Grid>

        <CheckBox Grid.Row="4"
              Content="{x:Static res:Lang.ZXW_UI_VeKyHieuTrucKichThuoc}"
              IsChecked="{Binding DrawAnnotations, Mode=TwoWay}"
              Margin="0,5,0,5"/>

        <Button Grid.Row="5"
            Content="{x:Static res:Lang.ZXW_UI_CaiDatGiaTriGoc}"
            Height="28"
            HorizontalAlignment="Stretch"
            Margin="0,5,0,5"
            Click="ResetButton_Click"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   Text="{Binding ValidationMessage}"
                   Foreground="#FFB42318"
                   FontSize="11"
                   Margin="0,5,10,0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton"
                    Content="{x:Static res:Lang.Common_UI_DongY}"
                    Width="80"
                    Height="28"
                    Margin="0,5,10,0"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Click="OkButton_Click"/>
                <Button Content="{x:Static res:Lang.Common_UI_Huy}"
                    Width="80"
                    Height="28"
                         Margin="0,5,0,0"
                    IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
