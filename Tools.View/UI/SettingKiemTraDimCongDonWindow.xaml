<Window
    x:Class="Tools.View.UI.SettingKiemTraDimCongDonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Tools.View.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tools.View.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    Title="{x:Static res:Lang.XLDCD_UI_SettingDimCongDon}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="{x:Static res:Lang.XLDCD_UI_SaiSoChoPhepDeXemDimLaLienTiepNhau}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.XLDCD_UI_KhoangCachLechPhuongChoPhep}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center"
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                    Foreground="Red"
                    Text="{Binding LechPhuong}"
                    TextAlignment="Right" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.XLDCD_UI_KhoangCachLechGiua2ChanDimChoPhep}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center"
                    behaviors:TextBoxBehavior.SelectAllTextOnFocus="True"
                    Foreground="Red"
                    Text="{Binding LechChanDim}"
                    TextAlignment="Right" />
            </Grid>
        </GroupBox>
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="{x:Static res:Lang.XLDCD_UI_XacLapQuyTacDimCongDon}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.XLDCD_UI_QuyTacPhuongNgang}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.Common_UI_TraiSangPhai}"
                    GroupName="HuongBoTriNgang"
                    IsChecked="{Binding IsLeftToRightHorizontal}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.XLDCD_UI_PhaiSangTrai}"
                    GroupName="HuongBoTriNgang"
                    IsChecked="{Binding IsRightToLeftHorizontal}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.XLDCD_UI_QuyTacPhuongDung}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.Common_UI_TrenXuongDuoi}"
                    GroupName="HuongBoTriDung"
                    IsChecked="{Binding IsTopToBottomVertical}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.XLDCD_UI_DuoiLenTren}"
                    GroupName="HuongBoTriDung"
                    IsChecked="{Binding IsBottomToTopVertical}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Static res:Lang.XLDCD_UI_QuyTacPhuongXien}" />
                <RadioButton
                    Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.XLDCD_UI_DuoiLenTren}"
                    GroupName="HuongBoTriXien"
                    IsChecked="{Binding IsBottomToTopAligned}" />
                <RadioButton
                    Grid.Row="2"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Lang.Common_UI_TrenXuongDuoi}"
                    GroupName="HuongBoTriXien"
                    IsChecked="{Binding IsTopToBottomAligned}" />
            </Grid>
        </GroupBox>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="70"
                Height="25"
                Margin="0,0,110,0"
                Command="{Binding OKCmd}"
                Content="OK" />
            <Button
                Width="70"
                Height="25"
                Command="{Binding CancelCmd}"
                Content="{x:Static res:Lang.Common_UI_Thoat}" />
        </StackPanel>
    </Grid>
</Window>
