<Window x:Class="Tools.View.UI.DoorOpeningSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[VinaCAD]-Thông số cửa"
        Width="450"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F3F3F3">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Chiều rộng lỗ cửa (W)">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Giá trị thông dụng (mm)" />
                <ListBox x:Name="HoleWidthList" Grid.Row="1" Margin="0,5" SelectionChanged="HoleWidthList_SelectionChanged" />
                <TextBox x:Name="HoleWidthText" Grid.Row="2" Height="27" Padding="4" HorizontalContentAlignment="Right" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Khoảng trụ tường">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Pier Width (mm)" />
                <ListBox x:Name="PierWidthList" Grid.Row="1" Margin="0,5" SelectionChanged="PierWidthList_SelectionChanged" />
                <TextBox x:Name="PierWidthText" Grid.Row="2" Height="27" Padding="4" HorizontalContentAlignment="Right" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Header="Kích thước kiểm soát">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Chiều cao cửa (H, mm)" />
                <TextBox x:Name="DoorHeightText" Grid.Column="1" Height="27" Padding="4" HorizontalContentAlignment="Right" />
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Chiều dày tường dự kiến (T, mm)" />
                <TextBox x:Name="WallThicknessText" Grid.Row="2" Grid.Column="1" Height="27" Padding="4" HorizontalContentAlignment="Right" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="2,10,2,0">
            <Button Width="145" Height="27" HorizontalAlignment="Left" Click="SameWidth_Click" Content="Trụ bằng rộng cửa" />
            <CheckBox x:Name="MiddleWallCheck"
                      Margin="0,9,0,0"
                      Checked="MiddleWallCheck_Changed"
                      Unchecked="MiddleWallCheck_Changed"
                      Content="Đặt lỗ cửa giữa đoạn tường" />
            <CheckBox x:Name="ReverseAlongWallCheck" Margin="0,7,0,0" Content="Đảo cửa trái/phải dọc theo tường" />
            <CheckBox x:Name="MirrorAcrossWallCheck" Margin="0,7,0,0" Content="Lật cửa vào/ra qua tim tường" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Text="Ký hiệu cửa tự co giãn theo W và được đặt đúng tim của cặp tường. Bỏ chọn đặt giữa: Pier Width được đo từ đầu tường gần điểm click." />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="82" Height="29" Margin="0,0,9,0" IsDefault="True" Click="Accept_Click" Content="OK" />
            <Button Width="82" Height="29" IsCancel="True" Click="Cancel_Click" Content="Hủy" />
        </StackPanel>
    </Grid>
</Window>
