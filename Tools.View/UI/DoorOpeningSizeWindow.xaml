<Window x:Class="Tools.View.UI.DoorOpeningSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[VinaCAD]-Độ rộng cửa/Khoảng trụ"
        Width="400"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F3F3F3">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Chọn độ rộng cửa">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Danh sách độ rộng" />
                <ListBox x:Name="HoleWidthList"
                         Grid.Row="1"
                         Margin="0,4"
                         SelectionChanged="HoleWidthList_SelectionChanged" />
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Độ rộng:" />
                    <TextBox x:Name="HoleWidthText"
                             Grid.Column="1"
                             Height="25"
                             Margin="5,0,0,0"
                             Padding="3"
                             HorizontalContentAlignment="Right" />
                </Grid>
                <Button Grid.Row="3"
                        Height="25"
                        Margin="0,5,0,0"
                        Click="MeasureHole_Click"
                        Content="Đo" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Chọn khoảng trụ">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Danh sách khoảng trụ" />
                <ListBox x:Name="PierWidthList"
                         Grid.Row="1"
                         Margin="0,4"
                         SelectionChanged="PierWidthList_SelectionChanged" />
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Khoảng trụ:" />
                    <TextBox x:Name="PierWidthText"
                             Grid.Column="1"
                             Height="25"
                             Margin="5,0,0,0"
                             Padding="3"
                             HorizontalContentAlignment="Right" />
                </Grid>
                <Button x:Name="MeasurePierButton"
                        Grid.Row="3"
                        Height="25"
                        Margin="0,5,0,0"
                        Click="MeasurePier_Click"
                        Content="Đo" />
            </Grid>
        </GroupBox>

        <Button x:Name="ExistingDoorWidthButton"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="25"
                Margin="2,8,2,0"
                Click="PickExistingDoorWidth_Click"
                Content="Lấy độ rộng từ cửa có sẵn" />

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="PocketWidthCheck"
                      VerticalAlignment="Center"
                      Checked="PlacementMode_Changed"
                      Unchecked="PlacementMode_Changed"
                      Content="Đo từ mép tường" />
            <CheckBox x:Name="MiddleWallCheck"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Checked="PlacementMode_Changed"
                      Unchecked="PlacementMode_Changed"
                      Content="Cửa giữa tường" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button Width="75" Height="28" Margin="0,0,12,0" IsDefault="True" Click="Accept_Click" Content="OK" />
            <Button Width="75" Height="28" IsCancel="True" Click="Cancel_Click" Content="Hủy" />
        </StackPanel>
    </Grid>
</Window>
