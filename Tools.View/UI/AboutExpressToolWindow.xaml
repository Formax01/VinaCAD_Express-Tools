<Window
    x:Class="Tools.View.UI.AboutExpressToolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tools.View.UI"
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static res:Lang.ABOUTEXPRESS_UI_ThongTinExpressTools}"
    Width="330"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition  />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="1"
            Grid.RowSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Image
                Width="100"
                Height="100"
                AutomationProperties.Name="Zalo Group Qr"
                Source="pack://application:,,,/Tools.Resources;component/Images/Zalo Group Gr.png"
                Stretch="Fill" />
        </StackPanel>

        <TextBlock
            Grid.Row="0"
            Margin="5,0,5,5"
            FontSize="22"
            Foreground="Black"
            Text="Express_Tools" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                <TextBlock Margin="10,0,0,4" Foreground="Black" TextWrapping="Wrap">
                    <Run Text="{x:Static res:Lang.ABOUTEXPRESS_UI_PhienBanHienTai}" />
                    <Run Text=": " />
                    <Run Text="{Binding CurrentVersion}" />
                </TextBlock>

                <TextBlock Margin="10,0,0,4" Foreground="Black" Text="Formax Technologies" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="10,16,0,0"
                VerticalAlignment="Top">
                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                    <Hyperlink
                        Command="{Binding HyperlinkCmd}"
                        Cursor="Hand"
                        TextDecorations="Underline">
                        <Run Text="{x:Static res:Lang.Common_Text_HuongDanSuDung}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Hyperlink
                        Command="{Binding FeedbackCmd}"
                        Cursor="Hand"
                        TextDecorations="Underline">
                        <Run Text="{x:Static res:Lang.ABOUTEXPRESS_UI_Feedback}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Button
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Width="70"
            Height="25"
            HorizontalAlignment="Right"
            Command="{Binding CloseCmd}"
            Content="{x:Static res:Lang.Common_UI_DongY}" />
    </Grid>
</Window>
