<Window x:Class="Tools.View.UI.LanguageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
        Title="{Binding [Language_Label], Source={x:Static res:Translator.Instance}}"
        Height="300" Width="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,5" FontWeight="Medium"
                   Text="{Binding [Language_Label], Source={x:Static res:Translator.Instance}}" />
        <ListBox Grid.Row="1" x:Name="LanguageList" DisplayMemberPath="DisplayName"
                 Margin="0,0,0,10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0,2,10,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="60" Margin="0,0,10,0" Padding="5,2"
                    IsDefault="True" Click="Apply_Click"
                    Content="{Binding [Language_Apply], Source={x:Static res:Translator.Instance}}" />
            <Button Width="60" Padding="5,2" IsCancel="True" Click="Cancel_Click"
                    Content="{x:Static res:Lang.Common_UI_Huy}" />
        </StackPanel>
    </Grid>
</Window>
