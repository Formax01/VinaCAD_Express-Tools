<Window
    x:Class="Tools.View.UI.BangTieuChuanNeoNoiCTWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tools.View.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Tools.Resources.Language;assembly=Tools.Resources"
    Title="{x:Static res:Lang.BTCNN_UI_BangTieuChuanChieuDaiNeoNoiCotThepToiThieu}"
    Width="940"
    Height="570"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.085*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="#B5B5B5"
                BorderThickness="1">

                <Image
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Source="{Binding ImageNeoNoiVN}"
                    Stretch="Uniform" />
            </Border>

            <Border Grid.Column="1" Background="White" />

            <Border
                Grid.Column="2"
                Background="White"
                BorderBrush="#B5B5B5"
                BorderThickness="1">

                <Image
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Source="{Binding ImageNeoNoiChauAu}"
                    Stretch="Uniform" />
            </Border>
        </Grid>

        <Button
            Grid.Row="1"
            Width="70"
            Height="25"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="{x:Static res:Lang.BTCNN_UI_Dong}"
            IsCancel="True" />
    </Grid>
</Window>
